# Web client environment configuration.
#
# Copy to .env.local and fill in. .env.local is gitignored.
# NEXT_PUBLIC_ variables are embedded in the browser bundle at build time, so
# nothing secret may ever be placed here.

# Base URL of the backend API. The frontend talks to this and nothing else —
# it never communicates with EscrowPay directly (docs/03-ESCROW-FLOW.md §8).
NEXT_PUBLIC_API_URL=http://localhost:4000
