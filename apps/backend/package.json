{
  "name": "@artist-escrow/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Express + Prisma REST API server",
  "type": "commonjs",
  "main": "src/index.ts",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "test": "node --test --test-force-exit \"test/**/*.test.ts\"",
    "seed": "node prisma/seed.ts",
    "create-admin": "node scripts/create-admin.ts",
    "start:worker": "node src/worker.ts",
    "dev:worker": "node --watch src/worker.ts",
    "build": "prisma migrate deploy && prisma generate",
    "postinstall": "prisma generate",
    "test:sandbox": "node --test --test-force-exit \"test/**/*.sandbox.ts\"",
    "test:all": "npm run test && npm run test:sandbox",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.81.5",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4"
  },
  "prisma": {
    "seed": "node prisma/seed.ts"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.0",
    "@types/qrcode": "^1.5.6",
    "typescript": "^7.0.2"
  }
}
