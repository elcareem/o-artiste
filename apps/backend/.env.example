# Backend environment configuration.
#
# Copy to .env and fill in. .env is gitignored and must never be committed.
# This file lists every variable the application reads; it grows as each issue
# introduces one. No real values belong here.

# --- Server ---------------------------------------------------------------

# Port the API binds to. Defaults to 4000 when unset. On a managed host this is
# usually injected by the platform — do not override it there.
PORT=4000

# development | production. Affects logging verbosity only.
NODE_ENV=development

# Browser origin permitted to call this API (the web client's URL).
# Defaults to http://localhost:3000 when unset. Set explicitly in every
# deployed environment.
WEB_ORIGIN=http://localhost:3000

# --- Database -------------------------------------------------------------

# PostgreSQL connection string. Prisma reads this directly.
DATABASE_URL=postgresql://user:password@localhost:5432/artist_escrow_dev?schema=public

# --- Authentication -------------------------------------------------------

# Signing key for session tokens. Generate a long random value per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The app refuses to sign or verify tokens when this is unset, rather than
# falling back to anything guessable — a predictable key means anyone can mint
# a SUPER_ADMIN token.
JWT_SECRET=

# Session token lifetime. Defaults to 7d when unset.
JWT_EXPIRES_IN=7d

# --- Job queue ------------------------------------------------------------

# Redis (or Valkey) connection string. BullMQ requires the instance to use the
# `noeviction` maxmemory policy: under an eviction policy Redis silently drops
# keys when memory fills, and those keys are queued jobs — a scheduled
# auto-release would vanish with no error anywhere.
REDIS_URL=redis://localhost:6379

# Queue namespace. Set per environment so a shared Redis cannot let one
# deployment's workers pick up another's jobs.
QUEUE_PREFIX=artist-escrow
