# Backend environment configuration.
#
# Copy to .env and fill in. .env is gitignored and must never be committed.
# This file lists every variable the application reads; it grows as each issue
# introduces one. No real values belong here.

# --- Server ---------------------------------------------------------------

# Port the API binds to. Defaults to 4000 when unset. On a managed host this is
# usually injected by the platform — do not override it there.
PORT=4000

# development | production. Affects logging verbosity only.
NODE_ENV=development

# Browser origin permitted to call this API (the web client's URL).
# Defaults to http://localhost:3000 when unset. Set explicitly in every
# deployed environment.
WEB_ORIGIN=http://localhost:3000

# --- Database -------------------------------------------------------------

# PostgreSQL connection string. Prisma reads this directly.
DATABASE_URL=postgresql://user:password@localhost:5432/artist_escrow_dev?schema=public

# --- Authentication -------------------------------------------------------

# Signing key for session tokens. Generate a long random value per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The app refuses to sign or verify tokens when this is unset, rather than
# falling back to anything guessable — a predictable key means anyone can mint
# a SUPER_ADMIN token.
JWT_SECRET=

# Session token lifetime. Defaults to 7d when unset.
JWT_EXPIRES_IN=7d

# --- Job queue ------------------------------------------------------------

# Redis (or Valkey) connection string. BullMQ requires the instance to use the
# `noeviction` maxmemory policy: under an eviction policy Redis silently drops
# keys when memory fills, and those keys are queued jobs — a scheduled
# auto-release would vanish with no error anywhere.
REDIS_URL=redis://localhost:6379

# Run the BullMQ workers inside the API process instead of as their own service.
#
# The separate `npm run start:worker` process is the production shape. Set this
# to `true` only where a second always-on service is not available — Render's
# free plan allows 750 instance-hours a month and one always-awake service uses
# about 730, so there is no room for a second free one.
#
# Leave it unset locally: run `npm run dev:worker` in a second terminal instead.
RUN_WORKERS_IN_WEB=

# Queue namespace. Set per environment so a shared Redis cannot let one
# deployment's workers pick up another's jobs.
QUEUE_PREFIX=artist-escrow

# --- Check-in codes -------------------------------------------------------
#
# The window in which an artist may redeem the client's code. Both are hours
# and both default sensibly when unset; set them per environment only if real
# usage says the defaults are wrong.

# How long BEFORE the event starts the code becomes redeemable. Defaults to 2.
# It exists at all because artists arrive early to set up, and a code that only
# works at the advertised start time strands them at the door.
CHECKIN_WINDOW_BEFORE_HOURS=2

# How long AFTER the event ends it stops being redeemable. Defaults to 12.
# Generous on purpose: an artist who forgot to check in during a five-hour set
# has still performed, and a narrow window turns that into a payment dispute.
CHECKIN_WINDOW_AFTER_HOURS=12

# How long before the event the code goes out by SMS. Defaults to 24.
#
# The code is written to the booking at funding, which can be months ahead —
# but it is not SENT then. A code received in June for a September wedding has
# been forwarded, screenshot and forgotten by the time it matters.
CHECKIN_CODE_SMS_LEAD_HOURS=24

# --- Notifications --------------------------------------------------------

# Filled in at #38. While unset, SMS is logged rather than sent, and the log
# line reports `stubbed`. Setting it before #38 lands makes sends THROW rather
# than silently do nothing — a half-configured notifier that quietly drops
# messages is worse than one that is obviously absent.
SMS_API_KEY=

# --- EscrowPay ------------------------------------------------------------

# Secret API key. Server-only — never in browser code, never NEXT_PUBLIC_.
# The key prefix decides the book: sk_test_… is the test book, sk_live_… is
# live. There is ONE host for both; going live is a key change, not a URL
# change.
ESCROWPAY_API_KEY=

# Defaults to the production merchant host when unset.
ESCROWPAY_BASE_URL=https://production-business-api.escrowpay.app/api/v1

# Client timeout in ms. Must stay below the host's request timeout; 15000 sits
# under the lowest figure Render has been reported to use.
ESCROWPAY_TIMEOUT_MS=15000

# Webhook signing secret (whsec_…), shown once when the endpoint is created.
# This is NOT the API key — it only verifies inbound POSTs to us.
ESCROWPAY_WEBHOOK_SECRET=

# During a secret rotation the provider accepts either secret for 24 hours.
# Set the outgoing one here for that window, then remove it.
ESCROWPAY_WEBHOOK_SECRET_PREVIOUS=
